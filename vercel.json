{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sent_emails.log", "destination": "/api/emails" },
    { "source": "/my_hackathon_module/(.*)", "destination": "/my_hackathon_module/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
