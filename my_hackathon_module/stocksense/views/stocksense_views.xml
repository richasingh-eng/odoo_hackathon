<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stocksense_product_list" model="ir.ui.view">
        <field name="name">stocksense.product.list</field>
        <field name="model">stocksense.product</field>
        <field name="arch" type="xml">
            <list string="Products">
                <field name="product_code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="quantity_on_hand"/>
            </list>
        </field>
    </record>

    <record id="view_stocksense_product_form" model="ir.ui.view">
        <field name="name">stocksense.product.form</field>
        <field name="model">stocksense.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <group>
                        <field name="product_code"/>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="quantity_on_hand"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stocksense_operation_list" model="ir.ui.view">
        <field name="name">stocksense.stock.picking.list</field>
        <field name="model">stocksense.stock.picking</field>
        <field name="arch" type="xml">
            <list string="Stock Operations">
                <field name="reference_no"/>
                <field name="operation_type"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="partner_name"/>
                <field name="status"/>
                <field name="total_quantity"/>
            </list>
        </field>
    </record>

    <record id="view_stocksense_operation_form" model="ir.ui.view">
        <field name="name">stocksense.stock.picking.form</field>
        <field name="model">stocksense.stock.picking</field>
        <field name="arch" type="xml">
            <form string="Stock Operation">
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'draft'"/>
                    <button name="action_done"
                            string="Done"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'confirmed'"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="status in ('done', 'cancelled')"/>
                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="reference_no" readonly="1"/>
                            <field name="operation_type"/>
                            <field name="partner_name"/>
                        </group>
                        <group>
                            <field name="source_location_id"/>
                            <field name="destination_location_id"/>
                            <field name="total_quantity" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Stock Moves">
                            <field name="move_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_code" readonly="1"/>
                                    <field name="product_name" readonly="1"/>
                                    <field name="uom" readonly="1"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stocksense_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">stocksense.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_stocksense_operation" model="ir.actions.act_window">
        <field name="name">Stock Operations</field>
        <field name="res_model">stocksense.stock.picking</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_stocksense_root" name="StockSense" sequence="10"/>
    
    <menuitem id="menu_stocksense_catalog" name="Catalog" parent="menu_stocksense_root" sequence="10"/>
    <menuitem id="menu_stocksense_products" name="Products" parent="menu_stocksense_catalog" action="action_stocksense_product" sequence="10"/>
    
    <menuitem id="menu_stocksense_ops" name="Operations" parent="menu_stocksense_root" sequence="20"/>
    <menuitem id="menu_stocksense_operations" name="Stock Operations" parent="menu_stocksense_ops" action="action_stocksense_operation" sequence="10"/>
</odoo>