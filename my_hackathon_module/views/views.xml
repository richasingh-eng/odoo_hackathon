<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product List View -->
    <record id="view_hackathon_product_tree" model="ir.ui.view">
        <field name="name">hackathon.product.tree</field>
        <field name="model">hackathon.product</field>
        <field name="arch" type="xml">
            <tree string="Products">
                <field name="product_code"/>
                <field name="product_name"/>
                <field name="category"/>
                <field name="uom"/>
                <field name="quantity_on_hand"/>
            </tree>
        </field>
    </record>

    <!-- Product Form View -->
    <record id="view_hackathon_product_form" model="ir.ui.view">
        <field name="name">hackathon.product.form</field>
        <field name="model">hackathon.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <group>
                        <group>
                            <field name="product_code"/>
                            <field name="product_name"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="uom"/>
                            <field name="quantity_on_hand"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Operation List View -->
    <record id="view_hackathon_operation_tree" model="ir.ui.view">
        <field name="name">hackathon.stock.operation.tree</field>
        <field name="model">hackathon.stock.operation</field>
        <field name="arch" type="xml">
            <tree string="Stock Operations">
                <field name="reference_no"/>
                <field name="operation_type"/>
                <field name="partner_name"/>
                <field name="product_code"/>
                <field name="quantity"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Action for Products -->
    <record id="action_hackathon_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">hackathon.product</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action for Operations -->
    <record id="action_hackathon_operations" model="ir.actions.act_window">
        <field name="name">Stock Operations</field>
        <field name="res_model">hackathon.stock.operation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action for Web Application -->
    <record id="action_stocksense_webapp" model="ir.actions.act_url">
        <field name="name">StockSense Live App</field>
        <field name="url">/stocksense</field>
        <field name="target">self</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_stocksense_root" name="StockSense IMS" sequence="10"/>
    <menuitem id="menu_stocksense_webapp" name="Open Web Application" parent="menu_stocksense_root" action="action_stocksense_webapp" sequence="1"/>
    <menuitem id="menu_stocksense_operations" name="Operations" parent="menu_stocksense_root" action="action_hackathon_operations" sequence="2"/>
    <menuitem id="menu_stocksense_products" name="Products" parent="menu_stocksense_root" action="action_hackathon_products" sequence="3"/>
</odoo>
