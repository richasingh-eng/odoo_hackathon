<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="stocksense_login_layout" inherit_id="web.login" name="StockSense Login">
        <xpath expr="//form[contains(@class, 'oe_login_form')]" position="before">
            <div class="stocksense_brand_header text-center mb-4">
                <h2 class="stocksense_title">StockSense</h2>
                <p class="stocksense_subtitle">Real-time Inventory Management System</p>
            </div>
        </xpath>
        <xpath expr="//form[contains(@class, 'oe_login_form')]" position="attributes">
            <attribute name="class">oe_login_form stocksense_auth_card</attribute>
        </xpath>
        <xpath expr="//div[contains(@class, 'field-password')]" position="after">
            <div class="d-flex justify-content-end mb-3">
                <a href="/web/reset_password" class="stocksense_forgot_link">Forgot Password?</a>
            </div>
        </xpath>
        <xpath expr="//div[contains(@class, 'oe_login_buttons')]" position="after">
            <div class="stocksense_divider">
                <span>OR</span>
            </div>
            <button type="button" class="btn btn-google w-100">
                <svg width="18" height="18" viewBox="0 0 18 18" style="margin-right: 8px; vertical-align: middle;">
                    <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.616z"/>
                    <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
                    <path fill="#FBBC05" d="M3.964 10.707c-.18-.54-.282-1.117-.282-1.707s.102-1.167.282-1.707V4.961H.957C.347 6.175 0 7.55 0 9s.347 2.825.957 4.039l3.007-2.332z"/>
                    <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 7.293C4.672 5.166 6.656 3.58 9 3.58z"/>
                </svg>
                Sign in with Google
            </button>
        </xpath>
    </template>

    <template id="stocksense_signup_layout" inherit_id="auth_signup.signup" name="StockSense Signup">
        <xpath expr="//form[contains(@class, 'oe_signup_form')]" position="before">
            <div class="stocksense_brand_header text-center mb-4">
                <h2 class="stocksense_title">StockSense</h2>
                <p class="stocksense_subtitle">Create Account - Warehouse Staff &amp; Managers</p>
            </div>
        </xpath>
        <xpath expr="//form[contains(@class, 'oe_signup_form')]" position="attributes">
            <attribute name="class">oe_signup_form stocksense_auth_card</attribute>
        </xpath>
    </template>
</odoo>
